# Copy to contracts/.env and fill in on YOUR machine. NEVER commit .env and never paste a private key into chat.
# Defaults for every setting live in config/networks.js; set a variable here only to override it.

# The deployer wallet (0xE8D1…CB45). Wave 1 needs test BNB, wave 2 needs about 0.3 BNB for gas.
DEPLOYER_PRIVATE_KEY=
# Contract verification on BscScan (Etherscan V2 key works for every chain)
ETHERSCAN_API_KEY=
# Optional private RPCs (default: public BNB Chain endpoints)
BSC_RPC=
BSC_TESTNET_RPC=

# --- overrides (leave empty to use config/networks.js) ---------------------
TREASURY=
TEAM=
ECOSYSTEM=
LIQUIDITY=
COMMUNITY=
GUARDIAN=
KEEPER=
LAUNCHER=
ATTESTER=                   # wallet that signs X / GitHub account proofs for the fee escrow (can be set later)
OWNER=                      # "deployer" keeps ownership with the deployer (testnet default)
AGENT_REGISTRY=             # "testnet" = deploy a free-claim TestnetAgentID
TEST_AGENTS=                # testnet: wallets that get an Agent ID right away, comma-separated
GRADUATION_TARGET=          # BNB: testnet 1, mainnet 16
GRADUATION_FEE_BPS=         # 300 = 3% of the target (capped at 2 BNB in the contract)
LAUNCH_FEE=                 # BNB: testnet 0, mainnet 0.005
META_FEE=                   # BNB: testnet 0, mainnet 0.01
WALLET_CAP_BPS=             # testnet 700 (7%), mainnet 100 (1%)
START_PAUSED=               # 1 = launches and buys paused (mainnet default)

# --- presale, all times UTC (testnet optional, mainnet required) ------------
PRESALE_START=              # e.g. 2026-11-25T13:00:00Z
PRESALE_DAYS=15
TGE=                        # planned listing date, e.g. 2026-12-11T14:00:00Z (vesting counts from it)
# PRESALE_SOFT_CAP=50  PRESALE_MIN=0.05  PRESALE_MAX=5   (floor 1 BNB = 1,000,000 AGNT up to 250 BNB, pro rata above)
