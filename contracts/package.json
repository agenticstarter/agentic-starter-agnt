{
  "name": "@agentic/contracts",
  "version": "1.0.0",
  "description": "Agentic Starter smart contracts (Hardhat)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "demo": "hardhat run scripts/local-demo.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "launch:agnt-testnet": "hardhat run scripts/launch-agnt-testnet.js --network bscTestnet",
    "set-launcher:testnet": "hardhat run scripts/set-launcher.js --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network bsc",
    "abi": "node scripts/export-abi.js",
    "verify:testnet": "hardhat run scripts/verify.js --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/verify.js --network bsc",
    "presale:test": "hardhat run scripts/deploy-presale.js --network bscTestnet",
    "presale:admin": "hardhat run scripts/presale-admin.js --network bscTestnet",
    "handover:mainnet": "hardhat run scripts/handover.js --network bsc"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "hardhat": "^2.29.1",
    "solc": "0.8.24"
  },
  "private": true
}
